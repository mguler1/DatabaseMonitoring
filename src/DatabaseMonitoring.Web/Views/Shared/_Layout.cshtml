<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DB Monitor</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <!-- DataTables CSS kasıtlı olarak yüklenmedi; dark stiller aşağıda sıfırdan yazıldı -->
    <style>
        /* ── Genel ─────────────────────────────────────────────── */
        body { background:#0f1117; color:#e2e8f0; font-family:'Segoe UI',sans-serif; }
        .navbar { background:#161b27 !important; border-bottom:1px solid #2d3748; }
        .navbar-brand { color:#60a5fa !important; font-weight:700; font-size:1.2rem; }
        .nav-link { color:#94a3b8 !important; }
        .nav-link:hover,.nav-link.active { color:#60a5fa !important; }
        .card { background:#161b27; border:1px solid #2d3748; border-radius:12px; }
        .card-header { background:#1e2535; border-bottom:1px solid #2d3748; border-radius:12px 12px 0 0 !important; }
        .stat-card { transition:transform .2s,box-shadow .2s; cursor:pointer; }
        .stat-card:hover { transform:translateY(-3px); box-shadow:0 8px 25px rgba(96,165,250,.15); }
        .badge-provider { font-size:.7rem; padding:4px 8px; border-radius:20px; }
        .progress { background:#2d3748; border-radius:4px; }
        .query-text { font-family:'Cascadia Code','Fira Code',monospace; font-size:.78rem; color:#93c5fd; white-space:pre-wrap; word-break:break-all; }
        .metric-value { font-size:1.6rem; font-weight:700; line-height:1; }
        .metric-label { font-size:.75rem; color:#64748b; margin-top:4px; }
        .tag-mssql { background:#1d4ed8; color:#bfdbfe; }
        .tag-postgresql { background:#065f46; color:#a7f3d0; }
        .tag-mysql { background:#92400e; color:#fde68a; }
        .section-title { font-size:.85rem; letter-spacing:.08em; text-transform:uppercase; color:#64748b; font-weight:600; }
        .alert-dark-info { background:#1e3a5f; border:1px solid #1d4ed8; color:#93c5fd; border-radius:8px; }
        .alert-dark-warn { background:#451a03; border:1px solid #92400e; color:#fde68a; border-radius:8px; }
        .footer { background:#161b27; border-top:1px solid #2d3748; color:#475569; font-size:.8rem; }
        .btn-outline-primary { border-color:#3b82f6; color:#60a5fa; }
        .btn-outline-primary:hover { background:#3b82f6; color:#fff; }
        ::-webkit-scrollbar { width:6px; height:6px; }
        ::-webkit-scrollbar-track { background:#0f1117; }
        ::-webkit-scrollbar-thumb { background:#2d3748; border-radius:3px; }

        /* ── Nav tabs ──────────────────────────────────────────── */
        .nav-tabs { border-bottom:1px solid #2d3748; }
        .nav-tabs .nav-link { color:#64748b; border-color:transparent; background:transparent; border-radius:6px 6px 0 0; }
        .nav-tabs .nav-link:hover { color:#94a3b8; border-color:#2d3748 #2d3748 transparent; }
        .nav-tabs .nav-link.active { background:#161b27; border-color:#2d3748 #2d3748 #161b27; color:#60a5fa; font-weight:600; }

        /* ── DataTables — tam dark sıfırdan ────────────────────── */

        /* wrapper */
        div.dataTables_wrapper {
            color: #e2e8f0;
            padding: 12px 0 0;
        }

        /* üst satır: length + filter */
        div.dataTables_wrapper div.dataTables_length,
        div.dataTables_wrapper div.dataTables_filter {
            margin-bottom: 10px;
        }
        div.dataTables_wrapper div.dataTables_length label,
        div.dataTables_wrapper div.dataTables_filter label {
            color: #94a3b8;
            font-size: 0.83rem;
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 0;
        }
        div.dataTables_wrapper div.dataTables_length select {
            background: #1e2535;
            border: 1px solid #2d3748;
            color: #e2e8f0;
            border-radius: 7px;
            padding: 5px 10px;
            font-size: 0.83rem;
            outline: none;
            cursor: pointer;
        }
        div.dataTables_wrapper div.dataTables_filter input[type="search"] {
            background: #1e2535;
            border: 1px solid #2d3748;
            color: #e2e8f0;
            border-radius: 7px;
            padding: 5px 10px;
            font-size: 0.83rem;
            outline: none;
            transition: border-color .2s;
        }
        div.dataTables_wrapper div.dataTables_filter input[type="search"]:focus {
            border-color: #3b82f6;
        }
        div.dataTables_wrapper div.dataTables_filter input[type="search"]::placeholder {
            color: #475569;
        }

        /* tablo */
        table.dataTable {
            border-collapse: collapse !important;
            width: 100% !important;
            background: #161b27;
        }

        /* header */
        table.dataTable thead tr {
            background: #1a2035;
        }
        table.dataTable thead th,
        table.dataTable thead td {
            background: #1a2035 !important;
            color: #64748b !important;
            border-bottom: 2px solid #2d3748 !important;
            border-top: none !important;
            padding: 10px 12px;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.07em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        /* sıralama ikonları */
        table.dataTable thead th.sorting,
        table.dataTable thead th.sorting_asc,
        table.dataTable thead th.sorting_desc { cursor: pointer; }
        table.dataTable thead .sorting::after,
        table.dataTable thead .sorting_asc::after,
        table.dataTable thead .sorting_desc::after { color: #3b82f6 !important; opacity: .6; }

        /* body satırlar */
        table.dataTable tbody tr {
            background: #161b27 !important;
        }
        table.dataTable tbody tr:hover td {
            background: #1e2535 !important;
        }
        table.dataTable tbody td {
            background: #161b27;
            color: #e2e8f0;
            border-bottom: 1px solid #1e2535 !important;
            border-top: none !important;
            padding: 9px 12px;
            vertical-align: middle;
        }

        /* Bootstrap .table override — sıfırla */
        .table { --bs-table-bg: #161b27; --bs-table-hover-bg: #1e2535; --bs-table-color: #e2e8f0; --bs-table-border-color: #1e2535; }
        .table > :not(caption) > * > * { background-color: var(--bs-table-bg) !important; color: var(--bs-table-color) !important; border-bottom-color: var(--bs-table-border-color) !important; box-shadow: none !important; }
        .table-hover > tbody > tr:hover > * { --bs-table-accent-bg: #1e2535; background-color: #1e2535 !important; }

        /* alt satır: info + paginate */
        div.dataTables_wrapper div.dataTables_info {
            color: #64748b;
            font-size: 0.8rem;
            padding-top: 10px;
        }
        div.dataTables_wrapper div.dataTables_paginate {
            padding-top: 6px;
        }
        div.dataTables_wrapper div.dataTables_paginate span .paginate_button,
        div.dataTables_wrapper div.dataTables_paginate .paginate_button {
            display: inline-block;
            padding: 4px 11px;
            margin: 0 2px;
            border: 1px solid #2d3748 !important;
            border-radius: 6px;
            background: transparent !important;
            color: #94a3b8 !important;
            font-size: 0.82rem;
            cursor: pointer;
            transition: border-color .15s, background .15s, color .15s;
            line-height: 1.5;
        }
        div.dataTables_wrapper div.dataTables_paginate .paginate_button:hover {
            background: #1e2535 !important;
            border-color: #3b82f6 !important;
            color: #60a5fa !important;
        }
        div.dataTables_wrapper div.dataTables_paginate .paginate_button.current,
        div.dataTables_wrapper div.dataTables_paginate .paginate_button.current:hover {
            background: #3b82f6 !important;
            border-color: #3b82f6 !important;
            color: #fff !important;
            font-weight: 600;
        }
        div.dataTables_wrapper div.dataTables_paginate .paginate_button.disabled,
        div.dataTables_wrapper div.dataTables_paginate .paginate_button.disabled:hover {
            color: #334155 !important;
            border-color: #1e2535 !important;
            background: transparent !important;
            cursor: default;
        }

        /* ────────────────────────────────────────────────────────── */
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg mb-4">
        <div class="container-fluid px-4">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="fas fa-database me-2"></i>DB Monitor
            </a>
            <button class="navbar-toggler border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navContent">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="fas fa-layer-group me-1"></i>Veritabanı Seç
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Connections" asp-action="Index">
                            <i class="fas fa-plug me-1"></i>Bağlantılar
                        </a>
                    </li>
                </ul>
                <span class="text-secondary small"><i class="fas fa-circle text-success me-1" style="font-size:.5rem"></i>Canlı</span>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4">
        <main>
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-5 py-3">
        <div class="container-fluid px-4">
            <span>DB Monitor &copy; @DateTime.Now.Year — Çoklu veritabanı izleme platformu</span>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
